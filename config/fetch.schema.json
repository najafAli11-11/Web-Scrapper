{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config/fetch.schema.json",
  "title": "Fetcher Settings",
  "description": "Validates config/fetch.json — deterministic fetcher settings (Spec req. 1-3): rate limiting, timeouts, emptiness threshold, pagination bounds. All settings live in versioned config, never hardcoded in agent logic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rate_limit_min_interval_seconds",
    "timeout_seconds",
    "extended_timeout_seconds",
    "empty_content_threshold_chars",
    "user_agent",
    "max_redirects",
    "browser_settle_seconds",
    "pagination_max_clicks",
    "backoff_base_seconds"
  ],
  "properties": {
    "rate_limit_min_interval_seconds": { "type": "number", "minimum": 0 },
    "timeout_seconds": { "type": "number", "minimum": 1 },
    "extended_timeout_seconds": { "type": "number", "minimum": 1 },
    "empty_content_threshold_chars": { "type": "integer", "minimum": 0 },
    "user_agent": { "type": "string", "minLength": 1 },
    "max_redirects": { "type": "integer", "minimum": 1 },
    "browser_settle_seconds": { "type": "number", "minimum": 0 },
    "pagination_max_clicks": { "type": "integer", "minimum": 0 },
    "backoff_base_seconds": { "type": "number", "minimum": 0 }
  }
}
