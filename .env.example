# API keys live in .env (gitignored), never in this file.
# Each key is optional — only the provider you use needs one.
# Copy to .env and fill in the key(s) for the provider in config/agents.json.

# NVIDIA NIM (default provider in config/agents.json)
NVIDIA_NIM_API_KEY=

# Common alternatives (set config/agents.json to match)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
